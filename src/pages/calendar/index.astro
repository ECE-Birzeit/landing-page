---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
---
<Base title="Academic calendar · ECE Hub" description="Birzeit University's academic calendar: holidays, add/drop and withdrawal deadlines, make-up days and exam periods for every semester, from Ritaj, checked daily. Add it to your own calendar." path="/calendar/" ogDescription="Holidays, deadlines, make-up days and exams at Birzeit University, from Ritaj's academic calendar." nav="calendar" skip={{ href: "#list", text: "Skip to the dates" }}>
<Fragment slot="head">
  <link rel="preconnect" href="https://raw.githubusercontent.com" crossorigin>
</Fragment>
<style is:global>
  /* What each kind of date is, as a small square in its colour. Green, the site's one accent, is for days
     off, the dates students look for most; the rest are toned to sit with it */
  [data-theme=light] { --k-holiday: var(--ok); --k-deadline: #b45309; --k-exams: #dc2626; --k-term: var(--i); --k-swap: #0369a1; --k-remote: #7e22ce; --k-staff: var(--mu); --k-ceremony: var(--mu2); --k-other: var(--mu) }
  [data-theme=dark] { --k-holiday: var(--ok); --k-deadline: #fbbf24; --k-exams: #f87171; --k-term: var(--i); --k-swap: #38bdf8; --k-remote: #c084fc; --k-staff: var(--mu); --k-ceremony: var(--mu2); --k-other: var(--mu) }

  main > .wrap { display: flex; flex-direction: column; gap: 20px; padding-top: 28px; padding-bottom: 72px }
  main > .wrap > * { min-width: 0 }

  /* Filters: which kinds of dates (toggles), and which year and semester (selects), as on the labs page */
  .tools { display: flex; flex-wrap: wrap; align-items: center; gap: 12px }
  .kinds { display: flex; flex-wrap: wrap; gap: 8px }
  .kinds .k { width: 8px; height: 8px; border-radius: 2px; background: var(--kc) }
  .tools .picks { display: flex; gap: 8px; margin-inline-start: auto }
  .tools .picks wa-select { width: 200px }
  @media (max-width: 860px) {
    .tools .picks { margin-inline-start: 0; width: 100% } .tools .picks wa-select { flex: 1; width: auto }
    .kinds { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100% } .kinds wa-button:first-child { grid-column: 1 / -1 }
  }

  .cols { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 24px; align-items: start }
  .side { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 88px }
  @media (max-width: 960px) { .cols { grid-template-columns: minmax(0, 1fr) } .side { position: static; order: -1 } }

  /* The next date, set like the hero's teaching week: one big number and what it counts down to */
  .soon { display: flex; flex-direction: column; gap: 16px; padding: 24px; border: 1px solid var(--line); border-radius: 16px; background: var(--card); box-shadow: var(--sh) }
  .soon-top { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; color: var(--mu) }
  .soon-top span:first-child { color: var(--mu2); font-weight: 500 }
  .soon-n { display: flex; align-items: flex-end; gap: 12px }
  .soon-n b { font: 500 88px/.8 var(--sans); letter-spacing: -.05em }
  .soon-n span { padding-bottom: 4px; font-size: 16px; line-height: 1.25; color: var(--mu2) }
  .soon-what { display: flex; gap: 12px; align-items: baseline; padding-top: 16px; border-top: 1px solid var(--line) }
  .soon-what .k { flex: none; width: 10px; height: 10px; border-radius: 3px; background: var(--kc); transform: translateY(1px) }
  .soon-what b { display: block; font: 500 16px/1.35 var(--sans) }
  .soon-what small { display: block; margin-top: 4px; font: 400 13px var(--mono); color: var(--mu) }

  /* After it: the next few, as a quiet list */
  .next { margin: 0; padding: 0; list-style: none }
  .next li { display: grid; grid-template-columns: 10px minmax(0, 1fr) auto; align-items: baseline; gap: 4px 12px; padding: 12px 16px; border-bottom: 1px solid var(--line) }
  .next li:last-child { border-bottom: 0 }
  .next .k { width: 10px; height: 10px; border-radius: 3px; background: var(--kc) }
  .next b { font: 500 14px/1.4 var(--sans) }
  .next small { grid-column: 2; font: 400 12px var(--mono); color: var(--mu) }
  .next em { grid-row: 1; grid-column: 3; font: 500 13px var(--mono); font-style: normal; color: var(--mu2); white-space: nowrap }
  .side wa-button { width: 100% }
  .note { margin: 0; font: 400 12px/1.6 var(--mono); color: var(--mu) }
  .note a { color: var(--mu2); text-underline-offset: 3px }

  /* The dates, month by month: a date tile, then what happens */
  /* [size] lifts this above wa.css's size rule, which ties with it and comes later in the built CSS */
  .bar wa-button[size] { --wa-form-control-height: 28px }
  .bar wa-button::part(button) { padding-inline: 12px; font-size: 12px }
  .month { display: flex; align-items: baseline; gap: 12px; padding: 16px 16px 8px; font: 500 16px var(--sans); color: var(--i) }
  .month small { font: 400 12px var(--mono); color: var(--mu) }
  .ev { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; align-items: start; gap: 4px 16px; margin: 0 8px; padding: 12px 8px; border-top: 1px solid var(--line) }
  .month + .ev { border-top: 0 }
  .day { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 8px 0; border: 1px solid var(--line); border-radius: 10px; background: var(--p) }
  .day b { font: 500 20px/1 var(--sans); letter-spacing: -.02em }
  .day small { font: 500 11px var(--mono); color: var(--mu) }
  .what { display: flex; flex-direction: column; gap: 4px; min-width: 0; padding-top: 4px }
  .what b { display: flex; align-items: baseline; gap: 8px; font: 500 15px/1.4 var(--sans) }
  .what b .k { flex: none; width: 8px; height: 8px; border-radius: 2px; background: var(--kc); transform: translateY(-1px) }
  .what .meta { font: 400 12px var(--mono); color: var(--mu) }
  .what .ar { font: 400 13px/1.6 var(--sans); color: var(--mu) }
  .ev .away { padding-top: 6px; font: 500 12px var(--mono); color: var(--mu2); white-space: nowrap }
  .ev.past { opacity: .5 }
  .ev.now .day { border-color: var(--ok) }
  .ev.now .away { color: var(--ok) }
  /* Today, between the past and the coming dates */
  .today { display: flex; align-items: center; gap: 12px; margin: 8px 16px; font: 500 12px var(--mono); color: var(--ok) }
  .today::after { content: ''; flex: 1; height: 1px; background: var(--ok) }
  #rows { padding-bottom: 8px }
  @media (max-width: 560px) {
    .ev { grid-template-columns: 52px minmax(0, 1fr); margin: 0 4px }
    .ev .away { grid-column: 2; padding-top: 0 }
  }

  @media print {
    .phead, .side, .tools, #updated, .bar wa-button { display: none !important }
    main > .wrap { padding: 0 !important }
    .cols { display: block !important }
    .ev { padding: 6px 8px; break-inside: avoid } .ev.past { opacity: 1 } .today { display: none }
  }
</style>

<main id="main">
  <PageHead title="Academic calendar">Holidays, deadlines, make-up days and exams for every semester at Birzeit University, from Ritaj's academic calendar and checked every day. To plan your classes, use the <a href="/timetable/">timetable builder</a>.</PageHead>

  <div class="wrap">
    <div class="tools">
      <div class="kinds" role="group" aria-label="Show">
        <wa-button appearance="outlined" class="seg" data-show="all" aria-pressed="true">All dates</wa-button>
        <wa-button appearance="outlined" class="seg" data-show="holiday" aria-pressed="false" style="--kc:var(--k-holiday)"><span slot="start" class="k" aria-hidden="true"></span>Days off</wa-button>
        <wa-button appearance="outlined" class="seg" data-show="deadline" aria-pressed="false" style="--kc:var(--k-deadline)"><span slot="start" class="k" aria-hidden="true"></span>Deadlines</wa-button>
        <wa-button appearance="outlined" class="seg" data-show="exams" aria-pressed="false" style="--kc:var(--k-exams)"><span slot="start" class="k" aria-hidden="true"></span>Exams</wa-button>
        <wa-button appearance="outlined" class="seg" data-show="swap" aria-pressed="false" style="--kc:var(--k-swap)"><span slot="start" class="k" aria-hidden="true"></span>Make-up days</wa-button>
      </div>
      <div class="picks">
        <wa-select id="year" aria-label="Academic year" hidden></wa-select>
        <wa-select id="term" aria-label="Semester"></wa-select>
      </div>
    </div>

    <div class="cols">
      <div class="win" id="list">
        <div class="bar"><span class="t" id="file">Academic calendar</span><span class="r"><wa-button appearance="outlined" size="s" class="seg" id="past" aria-pressed="false">Past dates</wa-button></span></div>
        <div id="rows"><div class="status">Loading the calendar…</div></div>
      </div>

      <div class="side">
        <div class="soon" id="soon" hidden>
          <div class="soon-top"><span>Next on the calendar</span><span id="today"></span></div>
          <div class="soon-n"><b id="soon-n"></b><span id="soon-l"></span></div>
          <div class="soon-what" id="soon-what"></div>
        </div>
        <div class="win" id="after-win" hidden>
          <div class="bar"><span class="t">After that</span></div>
          <ol class="next" id="next"></ol>
        </div>
        <wa-button appearance="outlined" id="ics" disabled>Add these dates to my calendar</wa-button>
        <wa-button appearance="outlined" size="s" class="seg" id="staff" aria-pressed="false">Include dates for academic staff</wa-button>
        <p class="note" id="src"></p>
      </div>
    </div>
    <span class="kicker" id="updated"></span>
  </div>
</main>

<script is:inline>
  (function () {
    // bzu-course-catalog reads Ritaj's public academic calendar every day and keeps every event in
    // calendar.json: per academic year, each event's date (and end), kind, English title, Ritaj's Arabic
    // text, and the semester it belongs to
    var DATA = 'https://raw.githubusercontent.com/mabushelbaia/bzu-course-catalog/main/data/';
    var KIND = { holiday: 'Day off', deadline: 'Deadline', exams: 'Exams', term: 'Teaching', swap: 'Make-up day', remote: 'Online teaching', staff: 'Staff', ceremony: 'Ceremony', other: '' };
    var GROUP = { holiday: 'holiday', deadline: 'deadline', exams: 'exams', term: 'exams', swap: 'swap', remote: 'swap' };
    var SEM = { '1': 'First semester', '2': 'Second semester', '3': 'Summer session' };
    var $ = function (id) { return document.getElementById(id); };
    var cal = null, years = [], state = { show: 'all', year: null, term: '', past: false, staff: false };

    function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function day(iso) { return new Date(iso + 'T12:00:00'); }
    function fmt(iso, o) { return day(iso).toLocaleDateString('en-GB', o); }
    // Today in Birzeit, whatever the visitor's clock says
    function today() { return new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Hebron', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date()); }
    function daysTo(iso) { return Math.round((day(iso) - day(today())) / 864e5); }
    function when(e) {
      return e.end ? fmt(e.date, { day: 'numeric', month: 'short' }) + ' – ' + fmt(e.end, { day: 'numeric', month: 'short' }) : fmt(e.date, { weekday: 'short', day: 'numeric', month: 'short' });
    }
    function away(e) {
      var t = today(), d = daysTo(e.date);
      if (e.date <= t) return e.end && e.end > t ? 'until ' + fmt(e.end, { day: 'numeric', month: 'short' }) : 'today';
      return d === 1 ? 'tomorrow' : d < 60 ? 'in ' + d + ' days' : 'in ' + Math.round(d / 7) + ' weeks';
    }
    function semShort(term) { return term ? SEM[term.slice(-1)] : ''; }
    function kc(e) { return 'var(--k-' + (KIND[e.kind] === undefined ? 'other' : e.kind) + ')'; }
    function title(e) { return e.title || e.ar; }

    // ?show=holiday&term=1262 makes a view shareable
    function readUrl() {
      var u = new URLSearchParams(location.search);
      if (/^(all|holiday|deadline|exams|swap)$/.test(u.get('show') || '')) state.show = u.get('show');
      if (/^\d{4}$/.test(u.get('term') || '')) state.term = u.get('term');
    }
    function writeUrl() {
      var u = new URLSearchParams();
      if (state.show !== 'all') u.set('show', state.show);
      if (state.term) u.set('term', state.term);
      var q = u.toString();
      history.replaceState(null, '', q ? '?' + q : location.pathname);
    }

    // The academic year that holds today, else the newest
    function pickYear() {
      var t = today();
      return years.filter(function (y) { var ev = cal.years[y].events; return ev.length && ev[0].date <= t && t <= ev[ev.length - 1].date; })[0] || years[0];
    }
    // Holidays and make-up days don't name a semester: they belong to the one whose teaching weeks hold them
    function inTerm(e, term) {
      var ev = cal.years[state.year].events;
      var start = ev.filter(function (x) { return x.term === term && x.title === 'Teaching starts'; })[0];
      var end = ev.filter(function (x) { return x.term === term && x.title === 'Final exams end'; })[0];
      return start && end && e.date >= start.date && e.date <= end.date;
    }
    function shown(events) {
      return events.filter(function (e) {
        if (!state.staff && e.kind === 'staff') return false;
        if (state.show !== 'all' && GROUP[e.kind] !== state.show) return false;
        if (state.term && (e.term ? e.term !== state.term : !inTerm(e, state.term))) return false;
        return true;
      });
    }

    function render() {
      if (!cal) return;
      writeUrl();
      document.querySelectorAll('.kinds .seg').forEach(function (b) { b.setAttribute('aria-pressed', b.dataset.show === state.show ? 'true' : 'false'); });
      $('past').setAttribute('aria-pressed', state.past ? 'true' : 'false');
      $('staff').setAttribute('aria-pressed', state.staff ? 'true' : 'false');
      var t = today(), list = shown(cal.years[state.year].events);
      var visible = list.filter(function (e) { return state.past || (e.end || e.date) >= t; });
      $('file').textContent = state.year + (state.term ? ' · ' + semShort(state.term) : '') + ' · ' + visible.length + (visible.length === 1 ? ' date' : ' dates');

      if (!visible.length) {
        $('rows').innerHTML = '<div class="status">' + (list.length ? 'Nothing more this year. Press “Past dates” to see the ones already gone.' : 'No dates of this kind.') + '</div>';
      } else {
        var html = '', month = null, marked = false;
        visible.forEach(function (e) {
          var m = e.date.slice(0, 7);
          if (state.past && !marked && (e.end || e.date) >= t) { html += '<div class="today">Today · ' + fmt(t, { weekday: 'short', day: 'numeric', month: 'short' }) + '</div>'; marked = true; month = null; }
          if (m !== month) {
            month = m;
            var n = visible.filter(function (x) { return x.date.slice(0, 7) === m; }).length;
            html += '<div class="month">' + fmt(e.date, { month: 'long', year: 'numeric' }) + '<small>' + n + (n === 1 ? ' date' : ' dates') + '</small></div>';
          }
          var past = (e.end || e.date) < t, now = !past && e.date <= t;
          var meta = [KIND[e.kind], e.end ? when(e) : fmt(e.date, { weekday: 'long' }), e.term && !state.term ? semShort(e.term) : '', e.expected ? 'expected' : ''].filter(Boolean).join(' · ');
          html += '<div class="ev' + (past ? ' past' : now ? ' now' : '') + '" style="--kc:' + kc(e) + '">' +
            '<div class="day" aria-hidden="true"><b>' + fmt(e.date, { day: 'numeric' }) + '</b><small>' + fmt(e.date, { month: 'short' }) + '</small></div>' +
            '<div class="what"><b><span class="k" aria-hidden="true"></span>' + esc(title(e)) + '</b><span class="meta">' + esc(meta) + '</span>' +
            (e.title ? '<span class="ar" lang="ar" dir="rtl">' + esc(e.ar) + '</span>' : '') + '</div>' +
            '<span class="away">' + (past ? '' : esc(away(e))) + '</span></div>';
        });
        $('rows').innerHTML = html;
      }

      // Next on the calendar, across every year whatever the filters (staff dates only when asked for)
      var all = [];
      years.forEach(function (k) { all = all.concat(cal.years[k].events); });
      var next = all.filter(function (e) { return (e.end || e.date) >= t && (state.staff || e.kind !== 'staff'); })
        .sort(function (a, b) { return a.date < b.date ? -1 : a.date > b.date ? 1 : 0; });
      var first = next[0];
      $('soon').hidden = !first;
      if (first) {
        var d = Math.max(0, daysTo(first.date));
        $('today').textContent = fmt(t, { weekday: 'short', day: 'numeric', month: 'short' });
        $('soon-n').textContent = d || 'Today';
        $('soon-l').innerHTML = d ? (d === 1 ? 'day' : 'days') + '<br>to go' : (first.end ? 'until ' + esc(fmt(first.end, { day: 'numeric', month: 'short' })) : '');
        $('soon-what').style.setProperty('--kc', kc(first));
        $('soon-what').innerHTML = '<span class="k" aria-hidden="true"></span><div><b>' + esc(title(first)) + '</b><small>' + esc(when(first) + (first.expected ? ' · expected' : '')) + '</small></div>';
      }
      var rest = next.slice(1, 5);
      $('after-win').hidden = !rest.length;
      $('next').innerHTML = rest.map(function (e) {
        return '<li style="--kc:' + kc(e) + '"><span class="k" aria-hidden="true"></span><b>' + esc(title(e)) + '</b><em>' + esc(away(e)) + '</em><small>' + esc(when(e)) + '</small></li>';
      }).join('');
      $('ics').disabled = !list.length;
    }

    // A calendar file of the dates shown: all-day events, so they sit at the top of the day in any calendar app
    $('ics').addEventListener('click', function () {
      var list = shown(cal.years[state.year].events);
      var ymd = function (iso, plus) { var d = day(iso); d.setDate(d.getDate() + (plus || 0)); return d.getFullYear() + String(d.getMonth() + 1).padStart(2, '0') + String(d.getDate()).padStart(2, '0'); };
      var text = function (s) { return String(s).replace(/[\\;,]/g, function (c) { return '\\' + c; }); };
      var stamp = new Date().toISOString().replace(/[-:]/g, '').slice(0, 15) + 'Z';
      var out = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//ECE Hub//Academic calendar//EN', 'CALSCALE:GREGORIAN', 'X-WR-CALNAME:Birzeit academic calendar ' + state.year];
      list.forEach(function (e, i) {
        out.push('BEGIN:VEVENT', 'UID:' + e.date + '-' + i + '-' + state.year.replace('/', '') + '@birzeit.me', 'DTSTAMP:' + stamp,
          'DTSTART;VALUE=DATE:' + ymd(e.date), 'DTEND;VALUE=DATE:' + ymd(e.end || e.date, 1),
          'SUMMARY:' + text(title(e) + (e.expected ? ' (expected)' : '')), 'DESCRIPTION:' + text(e.ar), 'TRANSP:TRANSPARENT', 'END:VEVENT');
      });
      out.push('END:VCALENDAR');
      var a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([out.join('\r\n') + '\r\n'], { type: 'text/calendar' }));
      a.download = 'birzeit-calendar-' + state.year.replace('/', '-') + (state.show !== 'all' ? '-' + state.show : '') + '.ics';
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
    });

    document.querySelector('.kinds').addEventListener('click', function (e) { var b = e.target.closest('.seg'); if (b) { state.show = b.dataset.show; render(); } });
    $('past').addEventListener('click', function () { state.past = !state.past; render(); });
    $('staff').addEventListener('click', function () { state.staff = !state.staff; render(); });
    // <wa-option> values can't hold a slash, so years go by their index
    $('year').addEventListener('change', function () { var y = years[+String(this.value).slice(1)]; if (y && y !== state.year) { state.year = y; state.term = ''; fillTerms(); facts(); render(); } });
    $('term').addEventListener('change', function () { state.term = this.value === 'all' ? '' : this.value; render(); });

    function fillTerms() {
      var terms = {}, y0 = String(+state.year.slice(0, 4) - 1900);
      cal.years[state.year].events.forEach(function (e) { if (e.term && e.term.slice(0, 3) === y0) terms[e.term] = 1; });
      if (!terms[state.term]) state.term = '';
      $('term').innerHTML = '<wa-option value="all">All semesters</wa-option>' + Object.keys(terms).sort().map(function (t) { return '<wa-option value="' + t + '">' + esc(semShort(t)) + '</wa-option>'; }).join('');
      $('term').value = state.term || 'all';
    }

    // The page head: this academic year, its holidays, make-up days and deadlines
    function facts() {
      var ev = cal.years[state.year].events;
      var count = function (k) { return ev.filter(function (e) { return e.kind === k; }).length; };
      $('pfacts').innerHTML = [[state.year, 'academic year'], [count('holiday'), 'holidays'], [count('swap'), 'make-up days'], [count('deadline'), 'deadlines']].map(function (p) {
        return '<div><dt>' + esc(p[1]) + '</dt><dd>' + esc(p[0]) + '</dd></div>';
      }).join('');
    }

    readUrl();
    fetch(DATA + 'calendar.json').then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); }).then(function (d) {
      cal = d; years = Object.keys(d.years);
      if (!years.length) throw new Error('empty');
      // A semester in the link picks its year
      var fromTerm = state.term && years.filter(function (y) { return String(+y.slice(0, 4) - 1900) === state.term.slice(0, 3); })[0];
      state.year = fromTerm || pickYear();
      $('year').innerHTML = years.map(function (y, i) { return '<wa-option value="y' + i + '">' + y + '</wa-option>'; }).join('');
      $('year').value = 'y' + years.indexOf(state.year);
      $('year').hidden = years.length < 2;
      fillTerms();
      facts();
      $('src').innerHTML = 'From Ritaj’s <a href="' + esc(d.years[state.year].source) + '" target="_blank" rel="noopener">public academic calendar</a>. Dates marked expected depend on the moon and can move by a day.';
      $('updated').textContent = 'Last change ' + fmt(d.updated_at.slice(0, 10), { day: 'numeric', month: 'short', year: 'numeric' }) + ' · checked against Ritaj every day';
      render();
    }).catch(function () {
      $('rows').innerHTML = '<div class="status">Couldn’t load the calendar. Check your connection and reload.</div>';
    });
  })();
</script>
<Fragment slot="footer">
  <a href="https://github.com/mabushelbaia/bzu-course-catalog" target="_blank" rel="noopener">Data: bzu-course-catalog<svg class="ext" viewBox="0 0 10 10" aria-hidden="true"><path d="M3 7l4-4M3.5 3H7v3.5"/></svg></a>
</Fragment>
</Base>
