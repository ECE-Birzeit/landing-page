---
// The people behind ECE Hub: everyone who has committed to its repositories, read from GitHub at build
// time (src/lib/github.ts), plus people credited by hand in src/data/credits.json for work that
// doesn't show up in git (reviewing a manual, testing experiments in the lab, supervising).
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { contributors } from '../../lib/github';
import credits from '../../data/credits.json';
import labs from '../../../public/labs/labs.json';

interface Credit { name: string; role: string; labs?: string[]; url?: string }

const { ok, repos, people } = await contributors();
const credited = credits as Credit[];
const commits = repos.reduce((n, r) => n + r.commits, 0);

// What each repository is, in the words students know it by
const LAB = new Map((labs as any[]).map((l) => [l.id, l]));
const label = (name: string) => {
  const lab = LAB.get(name);
  if (lab) return `${lab.code} manual`;
  if (name.endsWith('-manual') && LAB.get(name.replace(/-manual$/, ''))) return `${LAB.get(name.replace(/-manual$/, '')).code} PDF manual`;
  return ({ 'landing-page': 'ECE Hub', 'lab-template': 'Lab template', 'bzu-course-catalog': 'Course catalog' } as Record<string, string>)[name] ?? name;
};
const initials = (n: string) => n.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
const plural = (n: number, one: string, many = one + 's') => `${n.toLocaleString('en')} ${n === 1 ? one : many}`;
const ISSUES = 'https://github.com/ECE-Birzeit/landing-page/issues/new/choose';
const GUIDE = 'https://github.com/ECE-Birzeit/.github/blob/main/CONTRIBUTING.md';
---
<Base title="Contributors · ECE Hub" description="The people behind ECE Hub: who writes the lab manuals, the code and the schedule data, and how to join them. Everything is open source." path="/contributors/" skip={{ href: '#people', text: 'Skip to the contributors' }}>
<style is:global>
  main .wrap { display: flex; flex-direction: column; gap: 40px; padding-top: 28px; padding-bottom: 76px }
  .sec { display: flex; flex-direction: column; gap: 16px }
  .sec > h2 { margin: 0; font: 500 22px/1.3 var(--sans); letter-spacing: -.01em }
  .sec > p { margin: -6px 0 0; max-width: 64ch; color: var(--mu2); line-height: 1.6 }

  /* People: one card each, avatar, name, what they worked on */
  .people { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 14px; margin: 0; padding: 0; list-style: none }
  .people > li { display: flex }
  .people a.card { display: flex; flex: 1; color: inherit; text-decoration: none; border-radius: var(--wa-border-radius-l) }
  .people wa-card { flex: 1; --spacing: 20px; transition: border-color .15s }
  .people a.card:hover wa-card { --border-color: var(--line2) }
  .who { display: flex; align-items: center; gap: 14px }
  .who wa-avatar { --size: 52px; flex: none }
  .who b { display: block; font-weight: 500; font-size: 16px }
  .who small { display: block; color: var(--mu); font-size: 13.5px }
  .did { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px }
  .count { margin-top: 14px; font-size: 13.5px; color: var(--mu2) }

  /* Repositories: what each one is and when it last changed */
  .repos { margin: 0; padding: 0; list-style: none; border: 1px solid var(--line); border-radius: 12px; background: var(--card); overflow: hidden }
  .repos li { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 4px 24px; padding: 16px 20px; border-top: 1px solid var(--line) }
  .repos li:first-child { border-top: 0 }
  .repos a { color: var(--i); font-weight: 500; text-decoration: underline; text-decoration-color: var(--line2); text-underline-offset: 3px }
  .repos a:hover { text-decoration-color: currentColor }
  .repos code { margin-inline-start: 8px; font: 400 12.5px var(--code, ui-monospace, monospace); color: var(--mu) }
  .repos p { grid-column: 1; margin: 0; font-size: 14px; color: var(--mu2) }
  .repos .meta { grid-column: 2; grid-row: 1 / span 2; text-align: end; font-size: 13.5px; color: var(--mu2); white-space: nowrap }
  .repos .meta span { display: block; color: var(--mu) }
  @media (max-width: 600px) { .repos li { grid-template-columns: minmax(0, 1fr) } .repos .meta { grid-column: 1; grid-row: auto; text-align: start } .repos .meta span { display: inline; margin-inline-start: 8px } }

  /* Ways in */
  .join { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 14px }
  .join wa-card { --spacing: 22px }
  .join h3 { margin: 0 0 6px; font: 500 17px var(--sans) }
  .join p { margin: 0 0 18px; color: var(--mu2); line-height: 1.55; font-size: 14.5px }
  .empty { margin: 0; color: var(--mu2) }
</style>
<main id="main">
  <PageHead title="Contributors" facts={ok ? [[people.length + credited.length, people.length + credited.length === 1 ? 'person' : 'people'], [repos.length, 'repositories'], [commits, 'commits']] : []}>
    The people who write the lab manuals, the code and the schedule data behind ECE Hub. It is all open source: fix a typo, test an experiment or bring a whole lab, and your name goes here.
  </PageHead>
  <div class="wrap">
    <section class="sec" id="people" aria-labelledby="people-h">
      <h2 id="people-h">People</h2>
      {!ok && <p class="empty">The list couldn't be loaded from GitHub when the site was built. See the people on <a href="https://github.com/ECE-Birzeit">GitHub</a>.</p>}
      <ul class="people">
        {people.map((p) => (
          <li>
            <a class="card" href={p.url} target="_blank" rel="noopener" aria-label={`${p.name} on GitHub`}>
              <wa-card appearance="outlined">
                <div class="who">
                  <wa-avatar image={`${p.avatar}&s=104`} label={p.name} initials={initials(p.name)} loading="lazy"></wa-avatar>
                  <span><b>{p.name}</b><small>@{p.login}</small></span>
                </div>
                <div class="did">{p.repos.map((r) => <wa-tag size="small" appearance="outlined">{label(r)}</wa-tag>)}</div>
                <div class="count">{plural(p.commits, 'commit')} across {plural(p.repos.length, 'repository', 'repositories')}</div>
              </wa-card>
            </a>
          </li>
        ))}
        {credited.map((c) => {
          const card = (
            <wa-card appearance="outlined">
              <div class="who">
                <wa-avatar label={c.name} initials={initials(c.name)}></wa-avatar>
                <span><b>{c.name}</b><small>{c.role}</small></span>
              </div>
              {c.labs?.length && <div class="did">{c.labs.map((l) => <wa-tag size="small" appearance="outlined">{label(l)}</wa-tag>)}</div>}
            </wa-card>
          );
          return <li>{c.url ? <a class="card" href={c.url} target="_blank" rel="noopener">{card}</a> : card}</li>;
        })}
      </ul>
    </section>

    {ok && (
      <section class="sec" aria-labelledby="repos-h">
        <h2 id="repos-h">Repositories</h2>
        <p>Every part of ECE Hub, and where to change it.</p>
        <ul class="repos">
          {repos.map((r) => (
            <li>
              <span><a href={r.url} target="_blank" rel="noopener">{label(r.name)}</a><code>{r.full}</code></span>
              {r.description && <p>{r.description}</p>}
              <div class="meta">{plural(r.commits, 'commit')}<span>updated <wa-relative-time date={r.pushed_at}></wa-relative-time></span></div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="sec" aria-labelledby="join-h">
      <h2 id="join-h">Join in</h2>
      <div class="join">
        <wa-card appearance="outlined">
          <h3>Report a mistake</h3>
          <p>A wrong register value, a broken link, a schedule that doesn't match Ritaj. Tell us where and we'll fix it.</p>
          <wa-button appearance="outlined" href={ISSUES} target="_blank">Open an issue</wa-button>
        </wa-card>
        <wa-card appearance="outlined">
          <h3>Improve a manual</h3>
          <p>Every manual page is a Markdown file on GitHub. Edit it in the browser and send the change for review.</p>
          <wa-button appearance="outlined" href={GUIDE} target="_blank">Read the guide</wa-button>
        </wa-card>
        <wa-card appearance="outlined">
          <h3>Bring your manual</h3>
          <p>Teaching or assisting a lab that isn't here yet? We'll help turn its manual into a site like the others.</p>
          <wa-button variant="brand" href="/#join">Bring a lab</wa-button>
        </wa-card>
      </div>
    </section>
  </div>
</main>
</Base>
<script>
  import '@awesome.me/webawesome/dist/components/avatar/avatar.js';
  import '@awesome.me/webawesome/dist/components/card/card.js';
  import '@awesome.me/webawesome/dist/components/tag/tag.js';
  import '@awesome.me/webawesome/dist/components/relative-time/relative-time.js';
</script>
