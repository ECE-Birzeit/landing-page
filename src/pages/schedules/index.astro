---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
---
<Base title="Weekly schedules · ECE Hub" description="Weekly schedules for every department at Birzeit University: browse by instructor, course or room, filtered by faculty and department. Updated daily from Ritaj." path="/schedules/" ogDescription="Browse Birzeit University schedules by department, instructor, course or room. Updated daily from Ritaj." nav="schedules" skip={{ href: "#week", text: "Skip to the schedule" }}>
<Fragment slot="head">
  <link rel="preconnect" href="https://raw.githubusercontent.com" crossorigin>
</Fragment>
<style is:global>
  .kicker { font: 400 12.5px var(--mono); color: var(--mu) }
  .btn { cursor: pointer; transition: background .15s, border-color .15s, color .15s }
  .btn:hover { background: var(--soft) }


  /* Terminal window */
  .win { border: 1px solid var(--line); border-radius: 12px; background: var(--card); overflow: hidden }
  .bar { display: flex; align-items: center; gap: 6px; height: 36px; padding: 0 14px; border-bottom: 1px solid var(--line); background: var(--bar); font: 400 12px var(--mono); color: var(--mu) }
  .bar i { flex: none; width: 9px; height: 9px; border-radius: 50%; background: var(--line2) }
  .bar .t { margin-inline-start: 8px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis }
  .bar .r { margin-inline-start: auto; white-space: nowrap }

  /* Page */
  main > .wrap { display: flex; flex-direction: column; gap: 20px; padding-top: 28px; padding-bottom: 72px }
  /* Let wide children (the sections table) scroll inside their own box instead of widening the page */
  main > .wrap > * { min-width: 0; max-width: 100% }
  .views { display: flex; gap: 8px }
  .seg { height: 48px; padding: 0 14px; border: 1px solid var(--line); border-radius: 8px; background: transparent; color: var(--mu2); font: 400 13px var(--mono); cursor: pointer; transition: border-color .15s, color .15s }
  .seg:hover { color: var(--i) }
  .seg[aria-pressed=true] { border-color: var(--i); color: var(--i) }
  /* The view switch is three <wa-button>s; the pressed one gets a filled surface */
  wa-button.seg { height: auto; padding: 0; border: 0; background: none }
  wa-button.seg::part(button) { height: 48px; width: 100% }
  wa-button.seg[aria-pressed=true]::part(button) { background: var(--soft); border-color: var(--i) }
  .tools { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px }
  /* The native select covers the whole box, so clicking anywhere on it (the › and the count too) opens the list */
  .pick { position: relative; display: block; overflow: hidden; width: min(600px, 100%); height: 48px; border: 1px solid var(--line2); border-radius: 10px; background: var(--card); cursor: pointer }
  .pick:hover, .pick:focus-within { border-color: var(--i) }
  .pick select { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0 var(--caret-w, 130px) 0 38px; border: 0; border-radius: inherit; outline: 0; background: transparent; color: var(--i); font: 400 14px var(--mono); text-overflow: ellipsis; appearance: none; -webkit-appearance: none; cursor: pointer }
  .pick select option { background: var(--card); color: var(--i) }
  .pick b, .pick .caret { position: absolute; top: 50%; transform: translateY(-50%); pointer-events: none }
  .pick b { left: 15px; font: 600 15px var(--display); color: var(--ok) }
  .pick .caret { right: 14px; font: 400 12px var(--mono); color: var(--mu); white-space: nowrap }
  .pick.dept { width: min(420px, 100%) }
  .pick.dept b { color: var(--mu) }
  .meta-right { margin-inline-start: auto }
  .status { padding: 28px; font: 400 13px var(--mono); color: var(--mu) }

  /* Week: days are the rows, time runs across */
  .gantt { display: grid; grid-template-columns: 72px minmax(0, 1fr) }
  .hhead { position: relative; height: 36px; border-bottom: 1px solid var(--line) }
  .hhead span { position: absolute; top: 50%; transform: translate(-50%, -50%); font: 400 11px var(--mono); color: var(--mu) }
  .hhead span:first-child { transform: translate(0, -50%) }
  .hhead span:last-child { transform: translate(-100%, -50%) }
  .dayl { height: 76px; display: flex; align-items: center; padding: 0 14px; border-bottom: 1px solid var(--line); font: 500 12px var(--mono); color: var(--mu2) }
  .lane { position: relative; height: 76px; border-bottom: 1px solid var(--line); border-inline-start: 1px solid var(--line); background-image: linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: calc(100% / var(--hours, 9)) 100% }
  .gantt > :nth-last-child(-n+2) { border-bottom: 0 }
  .gantt > .status { grid-column: 1 / -1 }
  .blk { position: absolute; top: 8px; bottom: 8px; padding: 6px 8px; border-radius: 7px; border: 1px solid var(--c); background: color-mix(in srgb, var(--c) 14%, var(--card)); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font: 400 11px/1.35 var(--mono); color: var(--mu2) }
  .blk b { display: block; overflow: hidden; text-overflow: ellipsis; font-size: 12px; font-weight: 700; color: var(--c) }
  .blk.low { top: 40px; bottom: 6px }
  .blk.high { bottom: 40px }

  /* Phone: day tabs and a list instead of the grid */
  .days { display: none; grid-template-columns: repeat(var(--days, 5), minmax(0, 1fr)); gap: 6px }
  .dtab { height: 46px; border: 1px solid var(--line); border-radius: 8px; background: transparent; color: var(--mu2); font: 500 12.5px var(--mono); cursor: pointer }
  .dtab small { display: block; font-size: 10px; color: var(--mu) }
  .dtab[aria-pressed=true] { border-color: var(--i); color: var(--i) }
  .agenda { display: none }
  .item { display: grid; grid-template-columns: 58px minmax(0, 1fr); gap: 12px; padding: 12px 14px; border-bottom: 1px solid var(--line) }
  .item:last-child { border-bottom: 0 }
  .item .tm { font: 500 12.5px/1.45 var(--mono); color: var(--mu2) }
  .item b { display: block; font: 600 14px var(--display); color: var(--c) }
  .item span { display: block; margin-top: 2px; font-size: 13.5px }
  .item small { display: block; margin-top: 2px; font: 400 11.5px var(--mono); color: var(--mu) }
  @media (max-width: 720px) {
    .week { display: none }
    .days { display: grid }
    .agenda { display: block }
    .views { width: 100% }
    .views .seg { flex: 1 }
    .meta-right { margin-inline-start: 0 }
  }

  /* Sections table; click a header to sort, again to reverse */
  .tbl { overflow-x: auto }
  table { width: 100%; border-collapse: collapse; font: 400 12.5px var(--mono) }
  th { height: 38px; padding: 0; border-bottom: 1px solid var(--line); background: var(--bar); text-align: start; white-space: nowrap }
  th button { width: 100%; height: 100%; display: flex; align-items: center; gap: 6px; padding: 0 14px; border: 0; background: transparent; color: var(--mu); font: 500 12.5px var(--mono); text-align: start; cursor: pointer }
  th button:hover { color: var(--i) }
  th button::after { content: '↕'; opacity: .35 }
  th[aria-sort=ascending] button, th[aria-sort=descending] button { color: var(--i) }
  th[aria-sort=ascending] button::after { content: '↑'; opacity: 1 }
  th[aria-sort=descending] button::after { content: '↓'; opacity: 1 }
  th.num button { justify-content: flex-end }
  td { height: 42px; padding: 0 14px; border-bottom: 1px solid var(--line); color: var(--mu2); white-space: nowrap }
  tr:last-child td { border-bottom: 0 }
  td.num { text-align: end }
  td.c { color: var(--i); font-weight: 700 }
  td .sw { display: inline-block; width: 8px; height: 8px; margin-inline-end: 8px; border-radius: 2px; background: var(--c) }

  /* Motion (same language as the home page): the page settles in on load; each time you pick an
     instructor, course or room the week's blocks grow in from their start time, day by day; agenda items
     and table rows follow. Only transform and opacity move, and none of it runs for reduced motion. */
  :root { --spring: cubic-bezier(.22, 1, .36, 1); --ease-out: cubic-bezier(.2, .75, .2, 1) }
  @keyframes rise { from { opacity: 0; transform: translateY(14px) } to { opacity: 1; transform: none } }
  @keyframes blk-in { from { opacity: 0; transform: translateY(6px) scaleX(.55) } to { opacity: 1; transform: none } }
  @keyframes row-in { from { opacity: 0; transform: translateY(6px) } to { opacity: 1; transform: none } }
  @media (prefers-reduced-motion: no-preference) {
    .phead .wrap > *, main .tools, main .week, main .days, main .agenda, main .tbl { animation: rise .7s var(--spring) backwards }
    main .tools { animation-delay: 60ms } main .week, main .days { animation-delay: 120ms } main .agenda, main .tbl { animation-delay: 180ms }
    [data-anim=all] .blk { transform-origin: left center; animation: blk-in .6s var(--spring) backwards; animation-delay: var(--k, 0ms) }
    [data-anim=all] .item { animation: row-in .5s var(--spring) backwards; animation-delay: var(--k, 0ms) }
    [data-anim=all] #tbody tr, [data-anim=rows] #tbody tr { animation: row-in .45s var(--ease-out) backwards; animation-delay: var(--k, 0ms) }
    .blk { transition: transform .35s var(--spring) }
    .blk:hover { transform: translateY(-2px); z-index: 1 }
    .seg, .dtab { transition: border-color .15s, color .15s, background .15s, transform .35s var(--spring) }
    .seg:active, .dtab:active { transform: scale(.96) }
    .seg[aria-pressed=true], .dtab[aria-pressed=true] { background: var(--soft) }
  }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important } }
</style>

<main id="main" data-anim="all">
  <PageHead title="Weekly schedules">The teaching week of any instructor, course or room at Birzeit University, read from Ritaj every day. Planning your semester? <a href="/timetable/">Build your schedule</a>.</PageHead>

  <div class="wrap">
    <div class="tools">
      <div class="views" role="group" aria-label="Browse by">
        <wa-button appearance="outlined" size="l" class="seg" data-view="instructor" aria-pressed="true">Instructors</wa-button>
        <wa-button appearance="outlined" size="l" class="seg" data-view="course" aria-pressed="false">Courses</wa-button>
        <wa-button appearance="outlined" size="l" class="seg" data-view="room" aria-pressed="false">Rooms</wa-button>
      </div>
      <label class="pick dept"><b aria-hidden="true">⌂</b><select id="dept" aria-label="Department" disabled><option>Loading…</option></select><span class="caret" id="deptcount">▾</span></label>
      <label class="pick"><b aria-hidden="true">›</b><select id="pick" disabled><option>Loading…</option></select><span class="caret" id="optcount">▾</span></label>
      <span class="kicker" id="summary"></span>
      <span class="kicker meta-right" id="updated"></span>
    </div>

    <div class="win week" id="week">
      <div class="bar"><i></i><i></i><i></i><span class="t" id="file">schedule</span><span class="r" id="span">08:00 – 17:00 · Sat – Thu</span></div>
      <div class="gantt" id="gantt"><div class="status">Loading the schedule…</div></div>
    </div>

    <div class="days" id="days" role="group" aria-label="Day"></div>
    <div class="win agenda">
      <div class="bar"><i></i><i></i><i></i><span class="t" id="dayname"></span><span class="r" id="daycount"></span></div>
      <div id="agenda"></div>
    </div>

    <div class="win tbl">
      <table>
        <thead><tr id="thead"></tr></thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
  </div>
</main>


<script is:inline>
  (function () {
    // Theme switch (same as the landing page)
    var root = document.documentElement;
    var mq = window.matchMedia('(prefers-color-scheme: dark)');
    var toggle = document.querySelector('.theme');
    var chosen = false;
    try { chosen = !!localStorage.getItem('ece-labs-theme'); } catch (e) {}
    function apply(mode) { root.setAttribute('data-theme', mode); toggle.setAttribute('aria-checked', mode === 'dark' ? 'true' : 'false'); }
    apply(root.getAttribute('data-theme'));
    toggle.addEventListener('click', function () {
      var mode = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      chosen = true;
      try { localStorage.setItem('ece-labs-theme', mode); } catch (e) {}
      apply(mode);
      render('theme');
    });
    mq.addEventListener('change', function (e) { if (!chosen) { apply(e.matches ? 'dark' : 'light'); render('theme'); } });

    // Live data from bzu-course-catalog, scraped daily from Ritaj: the whole university's semester in one
    // file, and Ritaj's faculties and departments with each one's course prefixes (departments.json)
    var DATA = 'https://raw.githubusercontent.com/mabushelbaia/bzu-course-catalog/main/data/';
    var ALL_DAYS = [['S', 'Sat'], ['U', 'Sun'], ['M', 'Mon'], ['T', 'Tue'], ['W', 'Wed'], ['R', 'Thu']];
    var DAYS = ALL_DAYS;
    var KEY = { instructor: 'inst', course: 'code', room: 'room' };
    var NOUN = { instructor: ['instructor', 'instructors'], course: ['course', 'courses'], room: ['room', 'rooms'] };
    var $ = function (id) { return document.getElementById(id); };
    var rows = [], names = {}, lists = {}, codes = [];
    // Departments: id -> { label, prefixes, groups: [[prefix, program name]] }. "all" is every course,
    // "f<id>" a whole faculty, "other" the prefixes Ritaj's tree doesn't place anywhere
    var units = {}, unitOrder = [], DEFAULT = '7261'; // Electrical and Computer Engineering
    var state = { view: 'instructor', dept: DEFAULT, sel: {}, day: null, sort: null };
    // Birzeit's buildings by the code rooms start with ("Masri109"); Ritaj spells a few codes differently
    var BUILDINGS = [
      ['A.Shaheen', 'Azeez Shaheen Building, Faculty of Arts'], ['Aggad', 'Omar Aggad Engineering Building'],
      ['Al.Juraysi', 'Abdul Rahman Al-Juraysi Building, Faculty of Business and Economics', 'Al-Juraysi'], ['Alghanim', 'Yusuf Ahmad Alghanim Library'],
      ['Alsadik', 'Riad Tawfik Al-Sadik Building, Faculty of Law and Public Administration'], ['Aweidah', 'Samir Aweidah Fine Arts, Music & Design Building'],
      ['Bahrain', "Kingdom of Bahrain Building for Women's Studies"], ['Bamieh', 'Mohammad Omran Bamieh Building, Faculty of Education'],
      ['Darwazah', 'Samih Darwazah Institute for Pharmaceutical Industries'], ['EL-haj', 'Ali El-Haj Stadium'],
      ['GYM', 'Physical Education Building'], ['IOL', 'Institute of Law Building'], ['Khoury', 'Said Khoury Building for Development Studies'],
      ['KNH', 'Kamal Naser Hall'], ['Maktoum', 'Sheikh Rashid Bin Said Al-Maktoum Building'], ['Masri', 'Munib Rashid Masri Building for Information Technology'],
      ['Masruji', 'Mohammad Masrouji Building for Media', 'Masrouji'], ['N.Shaheen', 'Naseeb Azeez Shaheen Building for Graduate Studies'],
      ['NSA', 'Naseeb Azeez Shaheen Auditorium'], ['O.Abdulhadi', 'Omar Abdulhadi Business Building'],
      ['PNH', 'Faculty of Pharmacy, Nursing and Health Professions Building'], ['S.Abdulhadi', 'Samir Abdulhadi Building, Faculty of Science, Math Wing'],
      ['SCI', 'Faculty of Science Building'], ['Sh.Shaheen', 'Shouky Shaheen Lecture Halls Building'], ['WKS', 'Engineering Workshops'],
      ['Zeenni', 'Najjad Zeenni Information Technology Center of Excellence']
    ];
    var bkey = function (x) { return x.toLowerCase().replace(/[.\-\s]/g, ''); };
    var BY_KEY = {};
    BUILDINGS.forEach(function (b) { BY_KEY[bkey(b[0])] = b[0]; if (b[2]) BY_KEY[bkey(b[2])] = b[0]; });
    function building(room) { var m = room.match(/^[A-Za-z.\-]+/); return (m && BY_KEY[bkey(m[0])]) || 'Other'; }
    function buildingGroups() { return BUILDINGS.map(function (b) { return [b[0], b[1]]; }).concat([['Other', 'Rooms not on the list']]); }
    function prefixOf(code) { return (code.match(/^[A-Za-z]*/) || [''])[0]; }
    function inDept(code) { var u = units[state.dept]; return !u || !u.prefixes || u.prefixes[prefixOf(code)] === 1; }
    function mins(t) { var p = t.split(':'); return +p[0] * 60 + +p[1]; }
    function short(n) { var p = n.split(' '); return p.length > 2 ? p[0] + ' ' + p[p.length - 1] : n; }
    function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function color(code) {
      var dark = root.getAttribute('data-theme') === 'dark';
      var pal = dark ? ['#4ade80', '#38bdf8', '#fb923c', '#f87171', '#c084fc', '#facc15', '#3cc5cb', '#f472b6'] : ['#15803d', '#0369a1', '#c2410c', '#dc2626', '#7e22ce', '#a16207', '#00787f', '#be185d'];
      return pal[codes.indexOf(code) % pal.length];
    }
    function label(view, x) { return view === 'course' ? x + '  ' + (names[x] || '') : x; }

    function facts(pairs) {
      $('pfacts').innerHTML = pairs.filter(function (p) { return p && p[0] !== null && p[0] !== ''; }).map(function (p) {
        return '<div><dt>' + esc(p[1]) + '</dt><dd>' + esc(typeof p[0] === 'number' ? p[0].toLocaleString('en') : p[0]) + '</dd></div>';
      }).join('');
    }
    // "First Semester 2026/2027" reads as the figure 2026/27 with the label "first semester"
    function termFact(name) {
      var m = String(name || '').match(/^(.*?)\s+(\d{4})\/\d{2}(\d{2})$/);
      return m ? [m[2] + '/' + m[3], m[1].toLowerCase()] : [name || '', 'semester'];
    }

    // ?view=room&q=Masri107 makes a choice shareable
    function readUrl() {
      var u = new URLSearchParams(location.search);
      if (u.get('dept')) state.dept = u.get('dept');
      if (KEY[u.get('view')]) state.view = u.get('view');
      if (u.get('q')) state.sel[state.view] = u.get('q');
    }
    function writeUrl() {
      var u = new URLSearchParams({ dept: state.dept, view: state.view, q: state.sel[state.view] || '' });
      history.replaceState(null, '', '?' + u.toString());
    }

    function buildUnits(tree, prefixes) {
      var title = function (p) { return p.name + (p.level && p.level !== 'Bachelor' ? ' (' + p.level + ')' : ''); };
      function unit(id, label, programs, group) {
        var u = { id: id, label: label, group: group, prefixes: {}, groups: [] };
        programs.forEach(function (p) {
          if (!u.prefixes[p.prefix]) { u.prefixes[p.prefix] = 1; u.groups.push([p.prefix, title(p)]); }
        });
        units[id] = u; unitOrder.push(id);
        return u;
      }
      units.all = { id: 'all', label: 'All departments', prefixes: null, groups: null }; unitOrder.push('all');
      var placed = {};
      tree.faculties.forEach(function (f) {
        var everything = f.departments.reduce(function (a, d) { return a.concat(d.programs); }, []).concat(f.programs);
        unit('f' + f.id, 'All of ' + f.name, everything, f.name);
        f.departments.forEach(function (d) { if (d.programs.length) unit(d.id, d.name.replace(/^Department of /, ''), d.programs, f.name); });
        // Programs that sit straight under the faculty, each on its own
        f.programs.forEach(function (p) { unit(p.id, title(p) + ' · ' + p.prefix, [p], f.name); });
        everything.forEach(function (p) { placed[p.prefix] = 1; });
      });
      tree.programs.forEach(function (p) { unit(p.id, title(p) + ' · ' + p.prefix, [p], 'University'); placed[p.prefix] = 1; });
      var rest = Object.keys(prefixes).filter(function (x) { return !placed[x]; }).sort();
      if (rest.length) unit('other', 'Courses not under a department', rest.map(function (x) { return { prefix: x, name: x }; }), 'University');
    }

    function load() {
      var checked = null, term = null;
      fetch(DATA + 'index.json').then(function (r) { return r.json(); }).then(function (idx) {
        checked = idx.checked_at || null;
        term = (idx.published_terms || Object.keys(idx.terms))[0];
        return Promise.all([fetch(DATA + term + '.json'), fetch(DATA + 'departments.json')]);
      }).then(function (rs) {
        if (!rs[0].ok) throw new Error(rs[0].status);
        return Promise.all([rs[0].json(), rs[1].ok ? rs[1].json() : { faculties: [], programs: [] }]);
      }).then(function (got) {
        var d = got[0], prefixes = {};
        d.courses.forEach(function (c) {
          prefixes[c.prefix] = 1;
          names[c.code] = c.name.replace(/\w\S*/g, function (w) { return w[0] + w.slice(1).toLowerCase(); });
          c.sections.forEach(function (s) {
            s.meetings.forEach(function (m) {
              if (m.start && m.end && ALL_DAYS.some(function (x) { return x[0] === m.day; }))
                rows.push({ code: c.code, sec: s.number, inst: s.instructor || 'TBA', day: m.day, start: m.start, end: m.end, room: m.room || 'TBA', enr: s.enrolled });
            });
          });
        });
        codes = Object.keys(names).sort(); // one colour per course, the same in every department
        buildUnits(got[1], prefixes);
        if (!units[state.dept]) state.dept = units[DEFAULT] ? DEFAULT : 'all';
        $('dept').innerHTML = deptOptions();
        $('dept').disabled = false;
        state.term = d.name;
        // checked_at: when Ritaj was last scraped (daily); updated_at: when this semester's data last changed
        var c = (checked || d.updated_at).slice(0, 10), u = d.updated_at.slice(0, 10);
        $('updated').textContent = 'Checked ' + c + ' from Ritaj' + (u !== c ? ' · last change ' + u : '');
        $('pick').disabled = false;
        scope();
        render();
      }).catch(function () {
        $('gantt').innerHTML = '<div class="status">Couldn’t load the schedule. Check your connection and reload.</div>';
      });
    }

    // The department picker: all departments, then each faculty (the whole faculty first)
    function deptOptions() {
      var html = '<option value="all">All departments</option>', group = null;
      unitOrder.forEach(function (id) {
        var u = units[id];
        if (id === 'all') return;
        if (u.group !== group) { html += (group ? '</optgroup>' : '') + '<optgroup label="' + esc(u.group) + '">'; group = u.group; }
        html += '<option value="' + esc(id) + '">' + esc(u.label) + '</option>';
      });
      return html + (group ? '</optgroup>' : '');
    }

    // The department narrows the instructor and course lists (its courses and who teaches them); rooms are
    // every room on campus. A week always shows everything in it, from any department.
    function scope() {
      var mine = rows.filter(function (r) { return inDept(r.code); });
      Object.keys(KEY).forEach(function (v) {
        var count = {};
        (v === 'room' ? rows : mine).forEach(function (r) { var x = r[KEY[v]]; if (x && x !== 'TBA') count[x] = 1; });
        lists[v] = Object.keys(count).sort(function (a, b) { return a.localeCompare(b); });
      });
      $('dept').value = state.dept;
      $('deptcount').textContent = (units[state.dept].prefixes ? Object.keys(units[state.dept].prefixes).length + ' prefixes ' : '') + '▾';
      $('dept').parentNode.style.setProperty('--caret-w', ($('deptcount').offsetWidth + 28) + 'px');
      facts([termFact(state.term), [lists.course.length, 'courses'], [lists.instructor.length, 'instructors'], [lists.room.length, 'rooms on campus']]);
    }

    var COLS = [
      { key: 'code', label: 'Course', val: function (g) { return g.code; } },
      { key: 'name', label: 'Title', val: function (g) { return names[g.code] || ''; } },
      { key: 'sec', label: 'Section', val: function (g) { return +g.sec || 0; } },
      { key: 'days', label: 'Days', val: function (g) { return 'SUMTWR'.indexOf(g.dayCodes[0]) * 1e4 + mins(g.start); } },
      { key: 'time', label: 'Time', val: function (g) { return mins(g.start) * 10 + 'SUMTWR'.indexOf(g.dayCodes[0]); } },
      { key: 'other', label: '', val: function (g) { return g.other; } },
      { key: 'enr', label: 'Enrolled', num: true, val: function (g) { return +g.enr || 0; } }
    ];

    function render(mode) {
      if (!rows.length) return;
      $('main').dataset.anim = mode === 'theme' ? 'none' : mode === 'sort' ? 'rows' : 'all';
      var view = state.view;
      if (!lists[view].length) {
        $('pick').innerHTML = '<option>Nothing this semester</option>';
        $('optcount').textContent = '▾';
        $('gantt').innerHTML = '<div class="status">No classes for this department this semester.</div>';
        $('agenda').innerHTML = ''; $('tbody').innerHTML = ''; $('days').innerHTML = ''; $('summary').textContent = '';
        writeUrl();
        return;
      }
      var sel = state.sel[view] && lists[view].indexOf(state.sel[view]) !== -1 ? state.sel[view] : lists[view][0];
      state.sel[view] = sel;
      writeUrl();
      document.querySelectorAll('.views .seg').forEach(function (b) { b.setAttribute('aria-pressed', b.dataset.view === view ? 'true' : 'false'); });

      var pick = $('pick');
      pick.setAttribute('aria-label', 'Choose ' + NOUN[view][0]);
      var opt = function (x) { return '<option value="' + esc(x) + '">' + esc(label(view, x)) + '</option>'; };
      // Courses are grouped by course prefix (a department's programs); instructors and rooms are one list
      var groups = units[state.dept].groups || Object.keys(lists.course.reduce(function (a, x) { a[prefixOf(x)] = 1; return a; }, {})).sort().map(function (x) { return [x, '']; });
      var optgroups = function (pairs, list, key) {
        return pairs.map(function (p) {
          var xs = list.filter(function (x) { return key(x) === p[0]; });
          return xs.length ? '<optgroup label="' + esc(p[0]) + (p[1] ? ' · ' + esc(p[1]) : '') + '">' + xs.map(opt).join('') + '</optgroup>' : '';
        }).join('');
      };
      pick.innerHTML = view === 'course' ? optgroups(groups, lists.course, prefixOf)
        : view === 'room' ? optgroups(buildingGroups(), lists.room, building)
        : lists[view].map(opt).join('');
      pick.value = sel;
      $('optcount').textContent = lists[view].length + ' ' + NOUN[view][1] + ' ▾';
      pick.style.setProperty('--caret-w', ($('optcount').offsetWidth + 28) + 'px');

      // A week shows everything the instructor teaches or the room holds, whatever the department
      var mine = rows.filter(function (r) { return r[KEY[view]] === sel; }).map(function (r) {
        return r;
      }).sort(function (a, b) {
        return 'SUMTWR'.indexOf(a.day) - 'SUMTWR'.indexOf(b.day) || mins(a.start) - mins(b.start);
      });
      // Sunday only when something meets then; hours stretch past 08:00–17:00 when classes do
      DAYS = ALL_DAYS.filter(function (d) { return d[0] !== 'U' || mine.some(function (r) { return r.day === 'U'; }); });
      var h0 = Math.min.apply(null, [8].concat(mine.map(function (r) { return Math.floor(mins(r.start) / 60); })));
      var h1 = Math.max.apply(null, [17].concat(mine.map(function (r) { return Math.ceil(mins(r.end) / 60); })));
      var span = (h1 - h0) * 60;
      $('gantt').style.setProperty('--hours', h1 - h0);
      $('days').style.setProperty('--days', DAYS.length);
      $('span').textContent = (h0 < 10 ? '0' : '') + h0 + ':00 – ' + h1 + ':00 · ' + DAYS[0][1] + ' – ' + DAYS[DAYS.length - 1][1];
      var line = function (r) { return view === 'room' ? short(r.inst) : view === 'course' ? 'Sec ' + r.sec + ' · ' + r.room : r.room; };
      $('file').textContent = NOUN[view][0] + ' · ' + label(view, sel);

      // Week grid
      var hours = '';
      for (var h = h0; h <= h1; h++) hours += '<span style="left:' + ((h - h0) / (h1 - h0) * 100) + '%">' + (h < 10 ? '0' : '') + h + ':00</span>';
      var html = '<div class="hhead"></div><div class="hhead">' + hours + '</div>';
      DAYS.forEach(function (d, di) {
        var dm = mine.filter(function (r) { return r.day === d[0]; });
        html += '<div class="dayl">' + d[1] + '</div><div class="lane">';
        dm.forEach(function (r, k) {
          var left = (mins(r.start) - h0 * 60) / span * 100, w = (mins(r.end) - mins(r.start)) / span * 100;
          // Meetings that overlap in time (two sections at once, in the course view) share the lane height
          var overlap = dm.filter(function (o) { return mins(o.start) < mins(r.end) && mins(r.start) < mins(o.end); });
          var cls = overlap.length > 1 ? (overlap.indexOf(r) === 0 ? ' high' : ' low') : '';
          html += '<div class="blk' + cls + '" style="--k:' + (di * 55 + k * 45) + 'ms;--c:' + color(r.code) + ';left:calc(' + left + '% + 3px);width:calc(' + w + '% - 6px)" title="' +
            esc(r.code + ' · ' + r.start + '–' + r.end + ' · ' + r.room + ' · ' + r.inst) + '"><b>' + esc(r.code) + '</b>' + esc(line(r)) + '</div>';
        });
        html += '</div>';
      });
      $('gantt').innerHTML = html;

      // Phone: day tabs and agenda
      if (!state.day || !mine.some(function (r) { return r.day === state.day; })) state.day = (mine[0] && mine[0].day) || 'M';
      $('days').innerHTML = DAYS.map(function (d) {
        var n = mine.filter(function (r) { return r.day === d[0]; }).length;
        return '<button type="button" class="dtab" data-day="' + d[0] + '" aria-pressed="' + (d[0] === state.day) + '">' + d[1] + '<small>' + (n || '·') + '</small></button>';
      }).join('');
      var today = mine.filter(function (r) { return r.day === state.day; });
      $('dayname').textContent = DAYS.filter(function (d) { return d[0] === state.day; })[0][1];
      $('daycount').textContent = today.length + (today.length === 1 ? ' class' : ' classes');
      $('agenda').innerHTML = today.length ? today.map(function (r, k) {
        return '<div class="item" style="--k:' + k * 50 + 'ms;--c:' + color(r.code) + '"><div class="tm">' + r.start + '<br>' + r.end + '</div><div><b>' + esc(r.code) + '</b><span>' + esc(names[r.code] || '') +
          '</span><small>' + esc(line(r) + (view === 'course' ? '' : ' · Sec ' + r.sec)) + '</small></div></div>';
      }).join('') : '<div class="status">No classes on this day.</div>';

      // Sections table: one row per section and time, days merged
      groups = {}; var order = [];
      mine.forEach(function (r) {
        var k = [r.code, r.sec, r.start, r.end, r.room].join('|');
        if (!groups[k]) { groups[k] = Object.assign({ dayCodes: [] }, r); order.push(k); }
        groups[k].dayCodes.push(r.day);
      });
      var table = order.map(function (k) {
        var g = groups[k];
        g.other = view === 'room' ? g.inst : view === 'course' ? short(g.inst) + ' · ' + g.room : g.room;
        return g;
      });
      COLS[5].label = view === 'room' ? 'Instructor' : view === 'course' ? 'Instructor · Room' : 'Room';
      if (state.sort) {
        var col = COLS.filter(function (c) { return c.key === state.sort.key; })[0];
        table.sort(function (a, b) {
          var x = col.val(a), y = col.val(b);
          var c = typeof x === 'number' ? x - y : String(x).localeCompare(String(y), undefined, { numeric: true });
          return state.sort.dir * (c || ('SUMTWR'.indexOf(a.dayCodes[0]) - 'SUMTWR'.indexOf(b.dayCodes[0])) || mins(a.start) - mins(b.start));
        });
      }
      $('thead').innerHTML = COLS.map(function (c) {
        var s = state.sort && state.sort.key === c.key ? (state.sort.dir > 0 ? 'ascending' : 'descending') : 'none';
        return '<th class="' + (c.num ? 'num' : '') + '" aria-sort="' + s + '"><button type="button" data-sort="' + c.key + '">' + c.label + '</button></th>';
      }).join('');
      $('tbody').innerHTML = table.map(function (g, k) {
        var days = g.dayCodes.map(function (x) { return DAYS.filter(function (d) { return d[0] === x; })[0][1]; }).join(' ');
        return '<tr style="--k:' + Math.min(k * 22, 330) + 'ms;--c:' + color(g.code) + '"><td class="c"><span class="sw"></span>' + esc(g.code) + '</td><td>' + esc(names[g.code] || '') + '</td><td>Sec ' + esc(g.sec) +
          '</td><td>' + days + '</td><td>' + g.start + '–' + g.end + '</td><td>' + esc(g.other) + '</td><td class="num">' + esc(g.enr) + '</td></tr>';
      }).join('');
      $('summary').textContent = table.length + (table.length === 1 ? ' section · ' : ' sections · ') + mine.length + (mine.length === 1 ? ' meeting a week' : ' meetings a week');
    }

    // Controls
    document.querySelector('.views').addEventListener('click', function (e) {
      var b = e.target.closest('.seg');
      if (!b) return;
      state.view = b.dataset.view;
      state.sort = null;
      render();
    });
    $('pick').addEventListener('change', function () { state.sel[state.view] = this.value; render(); });
    // A room (or an instructor still in the new list) stays selected across departments
    $('dept').addEventListener('change', function () { state.dept = this.value; state.sort = null; scope(); render(); });
    $('days').addEventListener('click', function (e) { var b = e.target.closest('.dtab'); if (b) { state.day = b.dataset.day; render(); } });
    // Sorting: first click sorts by that column, the next click on the same column reverses it
    $('thead').addEventListener('click', function (e) {
      var b = e.target.closest('button[data-sort]');
      if (!b) return;
      var key = b.dataset.sort;
      state.sort = state.sort && state.sort.key === key ? { key: key, dir: -state.sort.dir } : { key: key, dir: 1 };
      render('sort');
      var again = document.querySelector('button[data-sort="' + key + '"]');
      if (again) again.focus();
    });

    readUrl();
    load();
  })();
</script>
