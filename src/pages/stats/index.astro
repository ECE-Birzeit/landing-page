---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
---
<Base title="Insights · ECE Hub" description="How Birzeit University ECE students use the lab sites this semester: students, experiment pages opened, busiest hours, devices and the most-opened experiments. Updated daily." path="/stats/" ogDescription="How ECE students use the lab sites this semester. Updated daily." nav="stats" skip={{ href: "#dash", text: "Skip to the insights" }}>
<Fragment slot="head">
  <link rel="preconnect" href="https://raw.githubusercontent.com" crossorigin>
  <link rel="stylesheet" href="/assets/widgets.css">
</Fragment>
<style is:global>
  .kicker { font: 400 12.5px var(--mono); color: var(--mu) }
  .btn { cursor: pointer; transition: background .15s, border-color .15s, color .15s }
  .btn:hover { background: var(--soft) }


  /* Each lab borrows its site's accent */
  [data-theme=light] [data-lab=encs4110] { --a: #dc2626 } [data-theme=light] [data-lab=encs4101] { --a: #0369a1 }
  [data-theme=light] [data-lab=encs5150] { --a: #c2410c } [data-theme=light] [data-lab=encs5101] { --a: #00787f }
  [data-theme=dark] [data-lab=encs4110] { --a: #f87171 } [data-theme=dark] [data-lab=encs4101] { --a: #38bdf8 }
  [data-theme=dark] [data-lab=encs5150] { --a: #fb923c } [data-theme=dark] [data-lab=encs5101] { --a: #3cc5cb }

  /* A terminal window: title bar with three dots, then content */
  .win { border: 1px solid var(--line); border-radius: 12px; background: var(--card); overflow: hidden; min-width: 0; display: flex; flex-direction: column }
  .bar { display: flex; align-items: center; gap: 6px; height: 36px; padding: 0 14px; border-bottom: 1px solid var(--line); background: var(--bar); font: 400 12px var(--mono); color: var(--mu) }
  .bar i { flex: none; width: 9px; height: 9px; border-radius: 50%; background: var(--line2) }
  .bar .t { margin-inline-start: 8px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis }
  .bar .r { margin-inline-start: auto; white-space: nowrap }

  /* Insights */
  main > .wrap { display: flex; flex-direction: column; gap: 18px; padding-top: 28px; padding-bottom: 76px }
  #body { display: flex; flex-direction: column; gap: 18px }
  .row2 { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 18px }
  .row11 { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px }
  @media (max-width: 900px) { .row2, .row11 { grid-template-columns: minmax(0, 1fr) } }
  .pad { display: flex; flex-direction: column; gap: 18px; padding: 22px }
  .kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)) }
  @media (max-width: 900px) { .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)) } }
  .kpi { display: flex; flex-direction: column; gap: 8px; padding: 24px 22px 22px; border-inline-end: 1px solid var(--line); border-bottom: 1px solid var(--line); margin: 0 -1px -1px 0; min-width: 0 }
  .kpi b { font: 500 clamp(34px, 4vw, 52px)/.95 var(--display); letter-spacing: -.03em }
  .kpi span { font: 500 13px var(--mono); color: var(--mu2) }
  .kpi small { font: 400 12px var(--mono); color: var(--mu) }
  .big { display: flex; align-items: baseline; gap: 10px }
  .big b { font: 500 52px/.9 var(--display); letter-spacing: -.03em }
  .big span { font: 400 13px var(--mono); color: var(--mu) }
  .facts { display: flex; flex-direction: column; gap: 8px; font: 400 12.5px var(--mono); color: var(--mu2) }
  .facts span:last-child { color: var(--mu) }
  .sep { padding-top: 18px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 14px }
  .tbl { width: 100%; border-collapse: collapse; font: 400 13px var(--mono) }
  .tbl th { padding: 0 22px 10px; font-weight: 400; font-size: 11.5px; color: var(--mu); text-align: end }
  .tbl td { padding: 13px 22px; border-top: 1px solid var(--line); text-align: end; white-space: nowrap }
  .tbl th:first-child, .tbl td:first-child { text-align: start }
  .tbl td:first-child { white-space: normal }
  .tbl td em { font-style: normal; color: var(--a) }
  .tbl td small { color: var(--mu) }
  .tbl tfoot td { background: var(--soft); font-weight: 700 }
  .tbl-box { overflow-x: auto }
  @media (max-width: 560px) { .tbl th, .tbl td { padding-inline: 12px } .tbl td small { display: none } }
  .note { margin: 0; padding: 14px 22px 18px; font: 400 12px/1.6 var(--mono); color: var(--mu) }
  .foot-note { margin: 6px 0 0; font: 400 12px/1.7 var(--mono); color: var(--mu) }
  .status { padding: 40px 22px; font: 400 13px var(--mono); color: var(--mu) }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important } }
</style>

<main>
  <PageHead title="How the labs are used">Who reads the lab sites this semester, when and on what, from the sites' analytics. Counted again every day.</PageHead>

  <div class="wrap" id="dash">

    <div class="status" id="status">Loading the numbers…</div>

    <div id="body" hidden>
      <div class="win">
        <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span class="t">this semester</span></div>
        <div class="kpis">
          <div class="kpi"><b id="k-students"></b><span>students</span><small id="k-students-n"></small></div>
          <div class="kpi"><b id="k-views"></b><span>experiment pages opened</span><small>across the four lab sites</small></div>
          <div class="kpi"><b id="k-per"></b><span>experiment pages per student</span><small>pages opened ÷ students</small></div>
          <div class="kpi"><b id="k-phone"></b><span>read on a phone or tablet</span><small id="k-phone-n"></small></div>
        </div>
      </div>

      <div class="row2">
        <div class="win"><div class="bar" aria-hidden="true"><i></i><i></i><i></i><span class="t">students per day</span></div>
          <div class="pad"><div class="w-title"><h2>Students per day</h2><span id="daily-note">hover a bar for the numbers</span></div><div id="w-daily"></div></div></div>
        <div class="win"><div class="bar" aria-hidden="true"><i></i><i></i><i></i><span class="t">semester</span></div>
          <div class="pad">
            <div class="w-title"><h2>Semester</h2><span id="term"></span></div>
            <div class="big"><b id="week"></b><span id="weeks"></span></div>
            <div id="w-sem"></div>
            <div class="facts" id="facts"></div>
          </div></div>
      </div>

      <div class="row2">
        <div class="win"><div class="bar" aria-hidden="true"><i></i><i></i><i></i><span class="t">week</span></div>
          <div class="pad"><div class="w-title"><h2>When students read</h2><span id="heat-note"></span></div><div id="w-heat"></div></div></div>
        <div class="win"><div class="bar" aria-hidden="true"><i></i><i></i><i></i><span class="t">devices</span></div>
          <div class="pad">
            <div class="w-title"><h2>Devices</h2><span>students</span></div><div id="w-dev"></div>
            <div class="sep"><div class="w-title"><h2>Students by lab</h2></div><div id="w-labs"></div></div>
          </div></div>
      </div>

      <div class="row11">
        <div class="win"><div class="bar" aria-hidden="true"><i></i><i></i><i></i><span class="t">most opened</span></div>
          <div class="pad"><div class="w-title"><h2>Most-opened experiments</h2><span>page views</span></div><div id="w-top"></div></div></div>
        <div class="win"><div class="bar" aria-hidden="true"><i></i><i></i><i></i><span class="t">labs</span></div>
          <div class="pad" style="padding-bottom: 6px"><div class="w-title"><h2>Every lab</h2><span>this semester</span></div></div>
          <div class="tbl-box"><table class="tbl">
            <thead><tr><th>Lab</th><th>Students</th><th>Views</th><th>Exps</th><th>Listings</th></tr></thead>
            <tbody id="labs"></tbody>
            <tfoot><tr id="labs-total"></tr></tfoot>
          </table></div>
          <p class="note" id="labs-note"></p>
        </div>
      </div>

      <p class="foot-note" id="foot-note"></p>
    </div>
  </div>
</main>


<script is:inline src="/assets/widgets.js"></script>
<script is:inline>
  (function () {
    // Theme switch (same as the landing page)
    var root = document.documentElement;
    var mq = window.matchMedia('(prefers-color-scheme: dark)');
    var toggle = document.querySelector('.theme');
    var chosen = false;
    try { chosen = !!localStorage.getItem('ece-labs-theme'); } catch (e) {}
    function apply(mode) { root.setAttribute('data-theme', mode); toggle.setAttribute('aria-checked', mode === 'dark' ? 'true' : 'false'); }
    apply(root.getAttribute('data-theme'));
    toggle.addEventListener('click', function () {
      var mode = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      chosen = true;
      try { localStorage.setItem('ece-labs-theme', mode); } catch (e) {}
      apply(mode);
    });
    mq.addEventListener('change', function (e) { if (!chosen) apply(e.matches ? 'dark' : 'light'); });

    var W = window.ECEWidgets, fmt = W.fmt;
    var $ = function (id) { return document.getElementById(id); };
    var NAMES = { encs4110: 'Computer Design Laboratory', encs4101: 'Embedded Systems Laboratory', encs5150: 'Advanced Computer Systems Engineering Laboratory', encs5101: 'Microprocessor and Embedded Systems Laboratory' };
    function cell(tag, text, cls) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }

    window.ECEWidgets.load().then(function (s) {
      var v = s && s.visitors;
      if (!v || !v.students) { $('status').textContent = 'The visitor numbers aren’t available right now.'; return; }
      var first = v.daily && v.daily.length ? W.day(v.daily[0][0]) : null;
      var wk = W.week(v.term_dates);
      // The page head: the semester, the teaching week and when the numbers were last counted
      var tm = String(v.term || '').match(/^(.*?)\s+(\d{4})\/\d{2}(\d{2})$/);
      var counted = new Date(s.generated_at.slice(0, 10) + 'T00:00:00');
      var pairs = [tm ? [tm[2] + '/' + tm[3], tm[1].toLowerCase()] : null, wk && wk.now <= wk.of ? [wk.now + ' of ' + wk.of, 'teaching week'] : null,
        [counted.getDate() + ' ' + counted.toLocaleString('en', { month: 'short' }), 'last counted']];
      $('pfacts').replaceChildren.apply($('pfacts'), pairs.filter(Boolean).map(function (x) {
        var d = cell('div'); d.appendChild(cell('dt', x[1])); d.appendChild(cell('dd', x[0])); return d;
      }));

      W.countUp($('k-students'), v.students);
      $('k-students-n').textContent = first ? 'unique visitors since ' + W.short(first) : '';
      W.countUp($('k-views'), v.experiment_views);
      W.countUp($('k-per'), +(v.experiment_views / v.students).toFixed(1), function (n) { return n.toFixed(1); });
      var d = v.devices || {}, tot = Object.keys(d).reduce(function (a, k) { return a + d[k]; }, 0);
      var small = (d.mobile || 0) + (d.tablet || 0);
      if (tot) W.countUp($('k-phone'), Math.round(100 * small / tot), function (n) { return Math.round(n) + '%'; }); else $('k-phone').textContent = '–';
      $('k-phone-n').textContent = fmt(small) + ' students';

      W.daily($('w-daily'), v, 190);
      if (first) $('daily-note').textContent = W.short(first) + ' to ' + W.short(W.day(v.daily[v.daily.length - 1][0])) + ' · hover a bar';

      $('term').textContent = v.term || '';
      if (wk) { $('week').textContent = 'Week ' + Math.min(wk.now, wk.of); $('weeks').textContent = 'of ' + wk.of; }
      W.semester($('w-sem'), v.term_dates);
      var td = v.term_dates || {};
      [['Teaching ends · ', td.teaching_ends], ['Finals · ', td.exams_start && td.exams_end ? W.short(W.day(td.exams_start)) + ' – ' + W.short(W.day(td.exams_end)) : null]].forEach(function (f) {
        if (f[1]) $('facts').appendChild(cell('span', f[0] + (f[1].length === 10 ? W.short(W.day(f[1])) : f[1])));
      });
      $('facts').appendChild(cell('span', 'Dates from Ritaj’s academic calendar'));

      W.heat($('w-heat'), v, 0, 23, [0, 6, 8, 12, 16, 20, 23]);
      W.byDay($('w-heat'), v);
      var best = W.busiest(v), bd = W.busiestDay(v);
      $('heat-note').textContent = 'page views by hour · busiest ' + W.DAYS[best[0]] + ' ' + String(best[1]).padStart(2, '0') + ':00' + (bd ? ' · busiest day ' + bd : '');
      W.devices($('w-dev'), v);
      W.labBars($('w-labs'), s.labs, 'students');
      W.top($('w-top'), v, 6);

      Object.keys(NAMES).forEach(function (l) {
        var x = s.labs[l]; if (!x) return;
        var tr = document.createElement('tr');
        tr.dataset.lab = l;
        var first = cell('td');
        first.append(cell('em', '■'), ' ', cell('b', l.toUpperCase()), ' ', cell('small', NAMES[l]));
        tr.append(first, cell('td', fmt(x.students)), cell('td', fmt(x.experiment_views)), cell('td', x.experiments), cell('td', x.code_listings));
        $('labs').appendChild(tr);
      });
      $('labs-total').append(cell('td', 'All labs'), cell('td', fmt(v.students)), cell('td', fmt(v.experiment_views)), cell('td', s.experiments), cell('td', s.code_listings));
      $('labs-note').textContent = 'A student who uses two labs counts once in the total, so the rows add up to more than ' + fmt(v.students) + '.';
      $('foot-note').textContent = (first ? 'Analytics on the lab sites began on ' + first.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) + '; teaching started on ' + W.day(td.teaching_starts).toLocaleDateString('en-GB', { day: 'numeric', month: 'long' }) + '. ' : '') +
        'Students are unique visitors as Google Analytics counts them (per browser). Page views count experiment pages only.';

      $('status').hidden = true;
      $('body').hidden = false;
      // Windows below the first screen rise in as they scroll into view
      document.querySelectorAll('#body .win').forEach(function (w) { W.reveal([w]); });
    }).catch(function () { $('status').textContent = 'Couldn’t load the numbers. Check your connection and reload.'; });
  })();
</script>
<Fragment slot="footer">
  <a href="/stats.json">Data: stats.json</a>
</Fragment>
</Base>
