---
// The head of every inner page: its title, one line on what it does (the default slot), and a row
// of figures. Pages that know their figures at build time pass them as `facts`; the others leave the
// row empty and their script writes into #pfacts. Styles live in base.css.
interface Props { title: string; facts?: [string | number, string][] }
const { title, facts = [] } = Astro.props;
const fmt = (n: string | number) => (typeof n === 'number' ? n.toLocaleString('en') : n);
---
<section class="phead">
  <div class="wrap">
    <h1>{title}</h1>
    <p class="lede"><slot /></p>
    <dl class="pfacts" id="pfacts" aria-live="polite">{facts.map(([n, label]) => <div><dt>{label}</dt><dd>{fmt(n)}</dd></div>)}</dl>
  </div>
</section>
